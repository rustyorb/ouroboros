# ============================================================
# Ouroboros — environment variables (copy to .env and fill in)
# ============================================================
# NEVER commit .env — it is in .gitignore

# --- Required ---
OPENROUTER_API_KEY=your_openrouter_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GITHUB_TOKEN=your_github_pat_here
GITHUB_USER=your_github_username
GITHUB_REPO=ouroboros

# Budget limit in USD (e.g. 10.0)
TOTAL_BUDGET=10.0

# --- Optional: models ---
# OUROBOROS_MODEL=anthropic/claude-sonnet-4-5
# OUROBOROS_MODEL_CODE=anthropic/claude-sonnet-4-5
# OUROBOROS_MODEL_LIGHT=google/gemini-flash-1.5

# --- Optional: LLM integrations ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=        # enables Claude Code CLI for code edits

# --- Optional: tuning ---
# OUROBOROS_MAX_WORKERS=5
# OUROBOROS_SOFT_TIMEOUT_SEC=600
# OUROBOROS_HARD_TIMEOUT_SEC=1800
# OUROBOROS_DIAG_HEARTBEAT_SEC=30
# OUROBOROS_DIAG_SLOW_CYCLE_SEC=20

# --- Storage paths (set automatically by Dockerfile — override if needed) ---
# OUROBOROS_DRIVE_ROOT=/data/ouroboros
# OUROBOROS_REPO_DIR=/app
