# ============================================================
# Ouroboros — environment variables template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ============================================================

# ---- Required -----------------------------------------------

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# GitHub personal access token (repo + workflow scopes)
GITHUB_TOKEN=your_github_token_here

# GitHub username and repo name
GITHUB_USER=your_github_username
GITHUB_REPO=ouroboros

# Total LLM budget in USD (agent stops when spent >= this)
TOTAL_BUDGET=10

# ---- Optional (sane defaults) -------------------------------

# OpenAI API key (for OpenAI-direct calls, not needed for OpenRouter)
# OPENAI_API_KEY=

# Anthropic API key (enables Claude Code CLI for code edits)
# ANTHROPIC_API_KEY=

# LLM models to use
# OUROBOROS_MODEL=anthropic/claude-sonnet-4.6
# OUROBOROS_MODEL_CODE=anthropic/claude-sonnet-4.6
# OUROBOROS_MODEL_LIGHT=anthropic/claude-haiku-4.5

# Worker pool size
# OUROBOROS_MAX_WORKERS=5

# Task timeouts (seconds)
# OUROBOROS_SOFT_TIMEOUT_SEC=600
# OUROBOROS_HARD_TIMEOUT_SEC=1800

# Diagnostics
# OUROBOROS_DIAG_HEARTBEAT_SEC=30
# OUROBOROS_DIAG_SLOW_CYCLE_SEC=20

# Paths (already set in docker-compose.yml, override here if needed)
# DRIVE_ROOT=/data/ouroboros
# REPO_DIR=/app/ouroboros_repo
